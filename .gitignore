# ==========================================
# 银杏家具 MVP · .gitignore
# 隐私/易变数据不入库；构建产物不跟踪
# ==========================================

# ---- Node 依赖 ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---- Python 虚拟环境 + 缓存 ----
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Playwright 测试产物 ----
test-results/
playwright-report/
playwright/.cache/
playwright/.local-browsers/

# ---- 用户上传的隐私图（保留 .gitkeep 让目录结构在）----
uploads/products/*
uploads/rooms/*
uploads/compositions/*
!uploads/products/.gitkeep
!uploads/rooms/.gitkeep
!uploads/compositions/.gitkeep

# ---- 易变 / 隐私数据（运行时由 server.js 自动生成）----
data/orders.json
data/uploads.json
data/users.json
data/generations.json
# 注：data/products.json 保留入仓（这是预填的 6+3 款商品种子数据）

# ---- 微信传来的测试图/临时图（不入库）----
data/*.jpg
data/*.jpeg
data/*.png

# ---- 环境变量 / 密钥（绝不入仓）----
.env
.env.local
.env.*.local
*.pem
*.key

# ---- 日志 ----
*.log
logs/

# ---- 操作系统垃圾 ----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- 临时文件 ----
tmp/
temp/
*.tmp
*.bak

# 本地调试脚本（不入仓）
click_*.mjs

# ---- v3 待入库原始图（本地暂存，不入库）----
data/new/
# ---- 入库工具运行状态 ----
tools/.ingested.json

# ---- 含密钥/隐私的本地备份快照（绝不入仓）----
.env.bak*
*.bak-*
*.v3-bak-*

# ---- 阿杏 AI 助手运行时数据（含手机号）----
data/appointments.json
data/scenes.json

# ---- 店铺经营分析（PM 批判）：含库存/定价弱点，只在本地，不推公开仓库 ----
docs/pm-critique-*.md
data/conversations.json

# ---- 产品宣传长图：带真实售价与门店信息，不推公开仓库 ----
# 这两张（以及日后再丢进来的同类宣传图）印着 ¥2,280~¥5,980 的实价、
# 门店地址/营业时间，第二张还带真实顾客的「预约到店」记录。
# 与 c65190f / 49416d7 同一个理由：定价和客流是竞争弱点，不进公开仓库。
# 文件名是内容哈希、每次不一样，所以按「docs 下 >1MB 的 PNG」兜底。
docs/9a4531b6cbe044ec4c578ecae92a9eb0.png
docs/a46cdb987c24aab147ac6d3b9ead8617.png

# ---- 工具本地台账（图片 → 商品 ID 的摄入记录，只在 开发 机上有意义）----
tools/.ingested.local-staging.json
